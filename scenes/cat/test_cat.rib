Display "test_cat.png" "file" "rgb"
Format 400 300 1
PixelSamples 2 2

Projection "perspective" "fov" [45.0]
Rotate -15 1 0 0
Rotate 30 0 1 0
Translate -0.5 21.5 -34

WorldBegin
  LightSource "ambientlight" "intensity" [0.5]
  LightSource "distantlight" "intensity" [0.8] "from" [0 0 1] "to" [0 0 0]

  # Simple test sphere at the cat's location
  AttributeBegin
    Color [1 0 0]
    Surface "constant"
    Translate 0.5 -21.5 31
    Sphere 0.5 -0.5 0.5 360
  AttributeEnd
WorldEnd
