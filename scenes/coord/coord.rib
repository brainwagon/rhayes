Display "coord.png" "file" "rgb"
Format 800 600 1
PixelSamples 2 2
ShadingRate 1.0

Projection "perspective" "fov" [45.0]
Translate 0 1 5

Sides 2

WorldBegin
  LightSource "ambientlight" "intensity" [0.3]
  LightSource "distantlight" "intensity" [0.7] "from" [1 1 1] "to" [0 0 0]

  # X axis
  TransformBegin
  Rotate 90 0 1 0
  Color [1 0 0]
  #Cylinder 0.1 0 1 360
  TransformEnd

  # Y axis
  TransformBegin
  Rotate 90 1 0 0
  Color [0 1 0]
  Cylinder 0.1 0 1 360
  TransformEnd

  # Z axis
  TransformBegin
  Color [0 0 1]
  Cylinder 0.1 0 1 360
  TransformEnd

WorldEnd
