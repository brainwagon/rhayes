##RenderMan RIB-Structure 1.1
version 3.03
Format 400 300 1
Display "texture.png" "file" "rgba"
Projection "perspective" "fov" 45
PixelSamples 2 2

TransformBegin
    Translate 0 2 -8
    Rotate 20 1 0 0
    Sides 2

    WorldBegin
        # Light
        LightSource "distantlight" "intensity" 1.0 "from" [0 10 -1]
        Surface "paintedplastic" "texturename" "textures/uvgrid.png"
        Patch "bilinear" "P" [
                -5 0 -5
                 5 0 -5
                -5 0  5
                 5 0  5
                ]
    WorldEnd
TransformEnd
