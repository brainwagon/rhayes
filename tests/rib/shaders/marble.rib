##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "marble.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -3
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 -1]
        Color [0.85 0.82 0.78]
        Surface "marble" "scale" 6.0
        Sphere 1 -1 1 360
    WorldEnd
TransformEnd
