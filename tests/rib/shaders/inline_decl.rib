##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "inline_decl.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -3
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 -1]
        Color [0.7 0.2 0.2]
        Surface "plastic" "float Kd" [0.8] "float Ks" [0.2]
        Sphere 1 -1 1 360
    WorldEnd
TransformEnd
