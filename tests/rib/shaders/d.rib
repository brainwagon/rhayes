##RenderMan RIB-Structure 1.1
version 3.03
Format 1024 1024 1
PixelSamples 2 2
Display "d.png" "file" "rgb"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -3
    Sides 2
    WorldBegin
        LightSource "distantlight" "intensity" 1.5 "from" [0 1 -1]
        Attribute "displacementbound" "float sphere" [0.05]
        Surface "bumpmatte"
        Sphere 1 -1 1 360
    WorldEnd
TransformEnd
