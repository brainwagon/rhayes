# Test: RiMatte hold-out matte objects
# A matte sphere sits in front of three opaque spheres.
# The matte sphere should:
#   - Cut a transparent hole (alpha=0, black) where it covers the background spheres
#   - Occlude the yellow sphere behind it (hidden completely)
#   - Leave the blue (left) and green (right) spheres partially visible
#     on either side of the matte sphere

Display "matte_holdout.png" "file" "rgba"
Format 400 300 1
PixelSamples 2 2
ShadingRate 1

Projection "perspective" "fov" [45]
TransformBegin
Translate 0 0 -6

WorldBegin

LightSource "ambientlight" "intensity" 0.3
LightSource "distantlight" "intensity" 0.8 "from" [1 2 -1] "to" [0 0 0]

# Blue opaque sphere (left, partially visible around matte)
AttributeBegin
    Color [0.2 0.3 0.9]
    Surface "plastic"
    Translate -1.5 0 2
    Sphere 0.8 -0.8 0.8 360
AttributeEnd

# Green opaque sphere (right, partially visible around matte)
AttributeBegin
    Color [0.2 0.8 0.3]
    Surface "plastic"
    Translate 1.5 0 2
    Sphere 0.8 -0.8 0.8 360
AttributeEnd

# Yellow opaque sphere (behind matte - should be completely hidden)
AttributeBegin
    Color [0.9 0.8 0.2]
    Surface "plastic"
    Translate 0 0 3
    Sphere 0.7 -0.7 0.7 360
AttributeEnd

# Matte sphere in center (hold-out: transparent where visible, occludes behind)
AttributeBegin
    Matte 1
    Translate 0 0 2
    Sphere 1 -1 1 360
AttributeEnd

WorldEnd
TransformEnd
