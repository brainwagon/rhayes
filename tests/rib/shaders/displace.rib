##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "displace.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -3
    WorldBegin
        LightSource "distantlight" "intensity" 1.5 "from" [0 1 -1]
        Attribute "displacementbound" "float sphere" [0.05]
        Surface "bumpmatte"
        Rotate -90 1 0 0
        Sphere 1 -1 1 360
    WorldEnd
TransformEnd
