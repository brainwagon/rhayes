##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "bilinear_textured.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -3
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 1]
        Color [1 1 1]
        Surface "paintedplastic" "texturename" "textures/checker.png"
        # Flat bilinear patch for texture mapping test
        Patch "bilinear" "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]
    WorldEnd
TransformEnd
