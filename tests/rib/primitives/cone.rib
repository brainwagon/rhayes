##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "cone.ppm" "file" "rgb"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 4
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 1]
        Color [0.2 0.2 0.8]
        Surface "plastic"
        Rotate -90 1 0 0
        Cone 1.5 0.5 360
    WorldEnd
TransformEnd
