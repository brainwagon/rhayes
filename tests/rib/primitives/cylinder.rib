##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "cylinder.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -4
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 1]
        Color [0.2 0.8 0.2]
        Surface "plastic"
        Rotate -90 1 0 0
        Cylinder 0.5 -1 1 360
    WorldEnd
TransformEnd
