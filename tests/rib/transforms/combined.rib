##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "combined.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 5
    Rotate -20 1 0 0
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 -1]
        Surface "plastic"
        # Multiple transforms combined
        AttributeBegin
            Color [0.8 0.2 0.2]
            Translate -1 0 0
            Scale 0.5 0.5 0.5
            Rotate 45 0 0 1
            Sphere 1 -1 1 360
        AttributeEnd
        AttributeBegin
            Color [0.2 0.8 0.2]
            Translate 1 0 0
            Scale 1 0.5 1
            Rotate -30 1 0 0
            Cylinder 0.5 -0.5 0.5 360
        AttributeEnd
    WorldEnd
TransformEnd
