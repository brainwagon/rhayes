##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "scale.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -4
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 -1]
        Surface "plastic"
        Color [0.8 0.4 0.8]
        # Scaled sphere (ellipsoid)
        Scale 1.5 0.75 1
        Sphere 1 -1 1 360
    WorldEnd
TransformEnd
