# Motion blur test - sphere moving horizontally
Format 400 300 1
Display "motion_blur.png" "file" "rgb"
Projection "perspective" "fov" 45
Hider "hidden" "jitter" [1]

# Enable motion blur (shutter open at 0, close at 1)
Shutter 0 1.0
PixelSamples 4 4

Translate 0 0 -5
WorldBegin

# Ambient light
LightSource "ambientlight" "intensity" 0.3

# Distant light
LightSource "distantlight" "intensity" 0.8 "from" [1 2 -1] "to" [0 0 0]

# Ground plane
Color [0.3 0.3 0.3]
Surface "matte"
Polygon "P" [-5 -1 -5  5 -1 -5  5 -1 5  -5 -1 5]

# Sphere with motion blur (moves from left to right)
Color [1 0 0]
Surface "plastic"
AttributeBegin
  MotionBegin [0 1]
    Translate -1.5 0 0
    Translate 1.5 0 0
  MotionEnd
  Sphere 0.5 -0.5 0.5 360
AttributeEnd

# Static reference sphere (no motion)
Color [0 0 1]
AttributeBegin
  Translate 0 1 0
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

WorldEnd
