# Motion blur stress test - 25 spheres with various motion
# Used to benchmark motion blur temporal sampling optimization
Format 640 480 1
Display "stress_motion.png" "file" "rgb"
Projection "perspective" "fov" 50
Hider "hidden" "jitter" [1]

# Enable motion blur
Shutter 0 1.0
PixelSamples 4 4

Translate 0 0 8
WorldBegin

# Ambient light
LightSource "ambientlight" "intensity" 0.2

# Key light
LightSource "distantlight" "intensity" 0.8 "from" [1 2 -1] "to" [0 0 0]

# Ground plane
Color [0.2 0.2 0.25]
Surface "matte"
Polygon "P" [-10 -2 -5  10 -2 -5  10 -2 5  -10 -2 5]

Surface "plastic"

# Row 1: Horizontal motion (5 spheres with varying speeds)
Color [1 0.2 0.2]
AttributeBegin
  MotionBegin [0 1]
    Translate -3 1.5 0
    Translate -1 1.5 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [1 0.4 0.2]
AttributeBegin
  MotionBegin [0 1]
    Translate -1 1.5 0
    Translate 1 1.5 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [1 0.6 0.2]
AttributeBegin
  MotionBegin [0 1]
    Translate 1 1.5 0
    Translate 3 1.5 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [1 0.8 0.2]
AttributeBegin
  MotionBegin [0 1]
    Translate 3 1.5 0
    Translate 5 1.5 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [1 1 0.2]
AttributeBegin
  MotionBegin [0 1]
    Translate 5 1.5 0
    Translate 7 1.5 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

# Row 2: Diagonal motion (5 spheres) - tests tight bounding box optimization
Color [0.2 1 0.3]
AttributeBegin
  MotionBegin [0 1]
    Translate -3 0 0
    Translate -1 1 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [0.2 1 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate -1 0 0
    Translate 1 1 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [0.2 1 0.7]
AttributeBegin
  MotionBegin [0 1]
    Translate 1 0 0
    Translate 3 1 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [0.2 1 0.9]
AttributeBegin
  MotionBegin [0 1]
    Translate 3 0 0
    Translate 5 1 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

Color [0.2 0.8 1]
AttributeBegin
  MotionBegin [0 1]
    Translate 5 0 0
    Translate 7 1 0
  MotionEnd
  Sphere 0.35 -0.35 0.35 360
AttributeEnd

# Row 3: Fast motion - long blur trails (5 spheres)
Color [0.3 0.3 1]
AttributeBegin
  MotionBegin [0 1]
    Translate -4 -1.5 0
    Translate 0 -1.5 0
  MotionEnd
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

Color [0.5 0.3 1]
AttributeBegin
  MotionBegin [0 1]
    Translate -2 -1.5 0
    Translate 2 -1.5 0
  MotionEnd
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

Color [0.7 0.3 1]
AttributeBegin
  MotionBegin [0 1]
    Translate 0 -1.5 0
    Translate 4 -1.5 0
  MotionEnd
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

Color [0.9 0.3 1]
AttributeBegin
  MotionBegin [0 1]
    Translate 2 -1.5 0
    Translate 6 -1.5 0
  MotionEnd
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

Color [1 0.3 0.9]
AttributeBegin
  MotionBegin [0 1]
    Translate 4 -1.5 0
    Translate 8 -1.5 0
  MotionEnd
  Sphere 0.3 -0.3 0.3 360
AttributeEnd

# Background spheres at z=2 (10 smaller spheres)
Color [0.5 0.4 0.4]
AttributeBegin
  MotionBegin [0 1]
    Translate -3 1 2
    Translate -1.5 1 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.5 0.5 0.4]
AttributeBegin
  MotionBegin [0 1]
    Translate -1 1 2
    Translate 0.5 1 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.5 0.6 0.4]
AttributeBegin
  MotionBegin [0 1]
    Translate 1 1 2
    Translate 2.5 1 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.4 0.5 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate -3 -0.5 2
    Translate -1.5 0 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.4 0.5 0.6]
AttributeBegin
  MotionBegin [0 1]
    Translate -1 -0.5 2
    Translate 0.5 0 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.4 0.6 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate 1 -0.5 2
    Translate 2.5 0 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.6 0.4 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate 3 0.5 2
    Translate 4.5 0.5 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.5 0.6 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate 3 -0.5 2
    Translate 4.5 0 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.6 0.5 0.5]
AttributeBegin
  MotionBegin [0 1]
    Translate 5 0.5 2
    Translate 6.5 0.5 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

Color [0.5 0.5 0.6]
AttributeBegin
  MotionBegin [0 1]
    Translate 5 -0.5 2
    Translate 6.5 0 2
  MotionEnd
  Sphere 0.2 -0.2 0.2 360
AttributeEnd

# Static reference sphere (no motion) for visual comparison
Color [0.9 0.9 0.9]
AttributeBegin
  Translate -4.5 0.5 0
  Sphere 0.4 -0.4 0.4 360
AttributeEnd

WorldEnd
