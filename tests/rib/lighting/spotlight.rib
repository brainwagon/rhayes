##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "spotlight.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Rotate 20 1 0 0
    Translate 0 0 -4
    WorldBegin
        # Spotlight aimed at center, showing cone falloff
        LightSource "spotlight" "intensity" 2 "from" [1.5 2 2] "to" [0 0 0] "coneangle" 10 "conedeltaangle" 1
        Surface "plastic"
        # Ground plane
        AttributeBegin
            Color [1.0 0.25 0.1]
            Surface "plastic"
            Polygon "P" [ -2 -0.5 -1.5   
                          -2 -0.5 1.5
                           2 -0.5 1.5  
                           2 -0.5 -1.5  
                          ]
        AttributeEnd
        # Row of spheres to show spotlight cone pattern
        AttributeBegin
            Color [0.8 0.8 0.8]
            Translate -1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.8 0.8 0.8]
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.8 0.8 0.8]
            Translate 1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
    WorldEnd
TransformEnd
