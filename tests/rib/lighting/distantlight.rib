##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "distantlight.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Rotate -20 1 0 0
    Translate 0 0 -4
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [1 1 -1]
        Surface "plastic"
        # Ground plane
        AttributeBegin
            Color [0.5 0.5 0.5]
            Surface "matte"
            Polygon "P" [-2 -0.5 -1.5  2 -0.5 -1.5  2 -0.5 1.5  -2 -0.5 1.5]
        AttributeEnd
        # Multiple spheres to show lighting direction
        AttributeBegin
            Color [0.8 0.8 0.8]
            Translate -1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.8 0.8 0.8]
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.8 0.8 0.8]
            Translate 1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
    WorldEnd
TransformEnd
