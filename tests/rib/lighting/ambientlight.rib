##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "ambientlight.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Rotate -20 1 0 0
    Translate 0 0 -4
    WorldBegin
        # Ambient light provides uniform illumination with no direction
        LightSource "ambientlight" "intensity" 0.8
        Surface "plastic"
        # Ground plane
        AttributeBegin
            Color [0.5 0.5 0.5]
            Surface "matte"
            Polygon "P" [-2 -0.5 -1.5  2 -0.5 -1.5  2 -0.5 1.5  -2 -0.5 1.5]
        AttributeEnd
        # Multiple spheres showing uniform lighting (no shadows or directional shading)
        AttributeBegin
            Color [0.8 0.2 0.2]
            Translate -1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.2 0.8 0.2]
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.2 0.2 0.8]
            Translate 1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
    WorldEnd
TransformEnd
