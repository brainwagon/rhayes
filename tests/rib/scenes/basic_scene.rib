##RenderMan RIB-Structure 1.1
version 3.03
Format 400 300 1
Display "basic_scene.png" "file" "rgba"
Projection "perspective" "fov" 45
PixelSamples 2 2

TransformBegin
    Rotate -25 1 0 0
    Translate 0 1 -6

    WorldBegin
        # Light
        LightSource "distantlight" "intensity" 1.0 "from" [0 1 -1]

        # Ground plane
        AttributeBegin
            Color [0.2 0.8 0.2]
            Surface "matte"
            Translate 0 -1 0
            Rotate -90 1 0 0
            Disk 0 3 360
        AttributeEnd

        # Red sphere
        AttributeBegin
            Color [0.9 0.1 0.1]
            Surface "plastic"
            Translate -1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd

        # Blue sphere
        AttributeBegin
            Color [0.1 0.1 0.9]
            Surface "metal"
            Translate 1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd

    WorldEnd
TransformEnd
