##RenderMan RIB-Structure 1.1
version 3.03
Format 200 200 1
Display "alpha.png" "file" "rgba"
Projection "perspective" "fov" 45
TransformBegin
    Translate 0 0 -5
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 1]
        Color [1 0 0]
        Opacity [0.5 0.5 0.5]
        Surface "matte"
        Polygon "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]

        TransformBegin
        Translate 0.7 0.7 -1
        Color [0 1 0]
        Opacity [0.5 0.5 0.5]
        Polygon "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]
        TransformEnd
    WorldEnd
TransformEnd
