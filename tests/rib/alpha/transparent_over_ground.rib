# Transparency test: semi-transparent sphere over opaque spheres
# This demonstrates proper A-buffer compositing with multiple depth layers

Display "transparent_over_ground.png" "file" "rgba"
Format 400 300 1
PixelSamples 2 2
ShadingRate 1

Projection "perspective" "fov" [45]
TransformBegin
Translate 0 0 -6

WorldBegin

LightSource "ambientlight" "intensity" 0.3
LightSource "distantlight" "intensity" 0.8 "from" [1 2 -1] "to" [0 0 0]

# Blue opaque sphere (back left)
AttributeBegin
    Color [0.2 0.3 0.9]
    Opacity [1 1 1]
    Surface "plastic"
    Translate -0.8 -0.3 2
    Sphere 0.8 -0.8 0.8 360
AttributeEnd

# Green opaque sphere (back right)
AttributeBegin
    Color [0.2 0.8 0.3]
    Opacity [1 1 1]
    Surface "plastic"
    Translate 0.8 -0.3 2
    Sphere 0.8 -0.8 0.8 360
AttributeEnd

# Yellow opaque sphere (back center)
AttributeBegin
    Color [0.9 0.8 0.2]
    Opacity [1 1 1]
    Surface "plastic"
    Translate 0 0.5 2.5
    Sphere 0.6 -0.6 0.6 360
AttributeEnd

# Semi-transparent red sphere in front (overlapping all three)
AttributeBegin
    Color [1 0.2 0.2]
    Opacity [0.5 0.5 0.5]
    Sides 2
    Surface "plastic"
    Translate 0 0 0
    Sphere 1.2 -1.2 1.2 360
AttributeEnd

WorldEnd
TransformEnd
