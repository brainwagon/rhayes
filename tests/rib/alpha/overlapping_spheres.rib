# Test transparency with overlapping spheres
# A red semi-transparent sphere in front of a blue sphere

Display "overlapping_spheres.png" "file" "rgba"
Format 400 300 1
PixelSamples 2 2
ShadingRate 1

Projection "perspective" "fov" [45]
TransformBegin
Translate 0 0 -6

WorldBegin

LightSource "ambientlight" "intensity" 0.3
LightSource "distantlight" "intensity" 0.8 "from" [1 2 -1] "to" [0 0 0]

# Blue opaque sphere (behind)
AttributeBegin
    Color [0.2 0.3 0.9]
    Opacity [1 1 1]
    Translate 0.5 0 1
    Sphere 1 -1 1 360
AttributeEnd

# Red semi-transparent sphere (in front)
AttributeBegin
    Color [1 0.2 0.2]
    Opacity [0.5 0.5 0.5]
    Sides 2
    Translate -0.3 0 0
    Sphere 1 -1 1 360
AttributeEnd

WorldEnd
TransformEnd
