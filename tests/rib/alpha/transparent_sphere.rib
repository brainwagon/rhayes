# Test scene for transparent object rendering
# A semi-transparent red sphere in front of an opaque blue ground plane

Display "transparent_sphere.png" "file" "rgba"
Format 400 300 1
PixelSamples 2 2
ShadingRate 1

Projection "perspective" "fov" [45]

# Camera setup: position objects in front of camera
Translate 0 0 -5

WorldBegin

# Ambient light for base illumination
LightSource "ambientlight" "intensity" 0.3

# Key light from upper right
LightSource "distantlight" "intensity" 0.8 "from" [2 3 -2] "to" [0 0 0]

# Opaque blue ground plane
AttributeBegin
    Color [0.2 0.3 0.8]
    Opacity [1 1 1]
    Translate 0 -1 0
    Rotate -90 1 0 0
    Disk 0 5 360
AttributeEnd

# Semi-transparent red sphere
AttributeBegin
    Color [1 0.2 0.2]
    Opacity [0.5 0.5 0.5]
    Sides 2
    Translate 0 0 0
    Sphere 1 -1 1 360
AttributeEnd

WorldEnd
