##RenderMan RIB-Structure 1.1
Format 640 480 1
PixelSamples 2 2
Display "tests/shadow/no_shadow_test.png" "file" "rgba"
Projection "perspective" "fov" 45

TransformBegin
# Move camera back along Z (objects move forward into positive Z space)
Translate 0 -3 -15

WorldBegin

# Light without shadow map
LightSource "spotlight" "from" [5 10 -5] "to" [0 0 0] "intensity" 80 "coneangle" 50 "conedeltaangle" 10
LightSource "ambientlight" "intensity" 0.1

# Ground plane
AttributeBegin
    Surface "matte"
    Color [0.8 0.8 0.8]
    Translate 0 -1 0
    Rotate -90 1 0 0
    Polygon "P" [-10 -10 0  10 -10 0  10 10 0  -10 10 0]
AttributeEnd

# Sphere
AttributeBegin
    Surface "plastic"
    Color [1 0 0]
    Translate 0 1 0
    Sphere 1.5 -1.5 1.5 360
AttributeEnd

WorldEnd
TransformEnd
