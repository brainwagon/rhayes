##RenderMan RIB-Structure 1.1
# shadow_render.rib - Render scene using the shadow map

Format 640 480 1
PixelSamples 4 4
Display "tests/shadow/shadow_render.png" "file" "rgba"
Projection "perspective" "fov" 45

TransformBegin
# Main camera position - viewing the scene from front
Translate 0 -3 -15

WorldBegin

# Light with shadow map
# Position matches where the shadow_map.rib camera was
LightSource "spotlight" "from" [5 10 -5] "to" [0 0 0] "intensity" 5 "coneangle" 50 "conedeltaangle" 10 "shadowmap" "tests/shadow/shadow.shd" "shadowsamples" 16 "shadowbias" 0.01 "shadowblur" 2.0

# Ambient fill light (no shadows)
LightSource "ambientlight" "intensity" 0.1

# Ground plane (receives shadow)
AttributeBegin
    Surface "matte"
    Color [0.8 0.8 0.8]
    Translate 0 -1 0
    Rotate -90 1 0 0
    Polygon "P" [-10 -10 0  10 -10 0  10 10 0  -10 10 0]
AttributeEnd

# Sphere (casts shadow)
AttributeBegin
    Surface "plastic"
    Color [1 0 0]
    Translate 0 1 0
    Sphere 1.5 -1.5 1.5 360
AttributeEnd

# Box (casts shadow)
AttributeBegin
    Surface "plastic"
    Color [0 1 0]
    Translate -3 0 2
    Scale 1 2 1
    Polygon "P" [-0.5 0 -0.5  0.5 0 -0.5  0.5 0 0.5  -0.5 0 0.5]
    Polygon "P" [-0.5 1 -0.5  -0.5 1 0.5  0.5 1 0.5  0.5 1 -0.5]
    Polygon "P" [-0.5 0 -0.5  -0.5 1 -0.5  0.5 1 -0.5  0.5 0 -0.5]
    Polygon "P" [-0.5 0 0.5  0.5 0 0.5  0.5 1 0.5  -0.5 1 0.5]
    Polygon "P" [-0.5 0 -0.5  -0.5 0 0.5  -0.5 1 0.5  -0.5 1 -0.5]
    Polygon "P" [0.5 0 -0.5  0.5 1 -0.5  0.5 1 0.5  0.5 0 0.5]
AttributeEnd

WorldEnd
TransformEnd
