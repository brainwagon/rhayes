##RenderMan RIB-Structure 1.1
# shadow_map.rib - Generate a shadow map from the light's perspective

Format 512 512 1
PixelSamples 1 1
Display "tests/shadow/shadow.shd" "file" "z"
Projection "perspective" "fov" 45

TransformBegin
# Position camera at light location (above and looking down at scene)
# First rotate to look down, then move back
Rotate 45 0 1 0
Rotate 50 1 0 0
Translate 0 0 -15

WorldBegin

# Ground plane (receives shadow)
AttributeBegin
    Surface "matte"
    Color [0.8 0.8 0.8]
    Translate 0 -1 0
    Rotate -90 1 0 0
    Polygon "P" [-10 -10 0  10 -10 0  10 10 0  -10 10 0]
AttributeEnd

# Sphere (casts shadow)
AttributeBegin
    Surface "plastic"
    Color [1 0 0]
    Translate 0 1 0
    Sphere 1.5 -1.5 1.5 360
AttributeEnd

# Box (casts shadow)
AttributeBegin
    Surface "plastic"
    Color [0 1 0]
    Translate -3 0 2
    Scale 1 2 1
    Polygon "P" [-0.5 0 -0.5  0.5 0 -0.5  0.5 0 0.5  -0.5 0 0.5]
    Polygon "P" [-0.5 1 -0.5  -0.5 1 0.5  0.5 1 0.5  0.5 1 -0.5]
    Polygon "P" [-0.5 0 -0.5  -0.5 1 -0.5  0.5 1 -0.5  0.5 0 -0.5]
    Polygon "P" [-0.5 0 0.5  0.5 0 0.5  0.5 1 0.5  -0.5 1 0.5]
    Polygon "P" [-0.5 0 -0.5  -0.5 0 0.5  -0.5 1 0.5  -0.5 1 -0.5]
    Polygon "P" [0.5 0 -0.5  0.5 1 -0.5  0.5 1 0.5  0.5 0 0.5]
AttributeEnd

WorldEnd
TransformEnd
