##RenderMan RIB-Structure 1.1
version 3.03
Format 400 300 1
Display "test_output.ppm" "file" "rgb"
Projection "perspective" "fov" 45
PixelSamples 2 2
TransformBegin
    Translate 0 0 5
    Rotate -20 1 0 0
    WorldBegin
        LightSource "distantlight" "intensity" 1 "from" [0 1 -1]
        AttributeBegin
            Color [0.2 0.8 0.2]
            Surface "matte"
            Translate 0 -1 0
            Rotate -90 1 0 0
            Disk 0 3 360
        AttributeEnd
        AttributeBegin
            Color [0.9 0.1 0.1]
            Surface "plastic"
            Translate -1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
        AttributeBegin
            Color [0.1 0.1 0.9]
            Surface "metal"
            Translate 1 0 0
            Sphere 0.5 -0.5 0.5 360
        AttributeEnd
    WorldEnd
TransformEnd
